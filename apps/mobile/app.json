{
  "expo": {
    "name": "Holofolio",
    "slug": "holofolio",
    "scheme": "holofolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.holofolio.app"
    },
    "android": {
      "package": "com.holofolio.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B3B8C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B3B8C",
          "image": "./assets/icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Holofolio uses your camera to scan the front and back of your Pokémon cards."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Holofolio needs access to your photos so you can select a card image when automatic scanning doesn't work."
        }
      ]
    ]
  }
}
