{
  "name": "pokedex-vault",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "server",
    "packages/*"
  ],
  "scripts": {
    "server:dev": "npm run dev --workspace server",
    "server:build": "npm run build --workspace server",
    "server:start": "npm run start --workspace server",
    "mobile:start": "npm run start --workspace apps/mobile",
    "shared:build": "npm run build --workspace packages/shared"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "prisma@5.22.0": true,
    "sharp@0.33.5": true
  }
}
