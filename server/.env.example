# Copy this to .env for local dev and fill in real values. Never commit the
# real .env file — it's already excluded via .gitignore.

# Local dev: "file:./dev.db" (SQLite). Production: a Postgres connection
# string, e.g. from Render's managed Postgres (Internal/External URL).
DATABASE_URL="file:./dev.db"

# Any long random string — used to sign auth tokens.
JWT_SECRET="change-me-to-a-long-random-string"

# AI card identification + condition inspection (Claude vision). Required
# for scanning to work at all; without it, identification falls back to
# manual search.
ANTHROPIC_API_KEY=""

# Card catalog lookups (pokemontcg.io).
POKEMONTCG_IO_API_KEY=""

# Raw market pricing aggregator (justtcg.com).
JUSTTCG_API_KEY=""

# eBay Browse API — active-listing pricing + graded-price comps. Must be
# PRODUCTION keys (App ID contains "-PRD-", not "-SBX-").
EBAY_APP_ID=""
EBAY_CERT_ID=""

# Optional: graded-price comps from pricecharting.com (requires a paid plan).
PRICECHARTING_API_TOKEN=""

# Optional: Collectr has no public API yet — leave blank.
COLLECTR_API_KEY=""

# Cloudflare R2 (S3-compatible object storage) for scanned card photos.
# Leave all four blank for local dev to fall back to local disk storage
# (served from /uploads) — required in production, since most hosts wipe
# local disk on every redeploy.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# The bucket's public URL base, no trailing slash — either its r2.dev dev
# URL or a custom domain mapped to it.
R2_PUBLIC_URL_BASE=""

PORT=4000
UPLOAD_DIR="./uploads"
